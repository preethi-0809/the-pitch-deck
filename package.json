{
  "name": "government-exam-ai",
  "version": "1.0.0",
  "description": "AI-Powered Government Exam Preparation Platform (UPSC, SSC, TNPSC, Banking, Railway, State PSC)",
  "main": "backend/src/server.js",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node backend/src/server.js",
    "app": "npm run build && node backend/src/server.js",
    "server": "node backend/src/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node database/seed/seedRunner.js",
    "turso:migrate": "node scripts/migrateToTurso.js",
    "turso:export": "node scripts/exportToTurso.js",
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "upsc",
    "ssc",
    "tnpsc",
    "banking",
    "railway",
    "ai-coach",
    "exam-preparation",
    "adaptive-learning"
  ],
  "author": "Antigravity AI",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.0",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
